<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{.Title}}</title>
    <link rel="stylesheet" href="/static/css/style.css">
    <link rel="stylesheet" href="/static/css/tailwindout.css">
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>
<body class="bg-[var(--bg)] text-[var(--fg)] min-h-screen">
    <div class="top-right">
        <a href="/settings" class="text-white/80 hover:text-[#ffd9a8] transition-colors duration-200">Settings</a>
        <div class="theme-selector">
            <select id="theme-select">
                <option value="default">Default</option>
                <option value="yotsuba">Yotsuba</option>
                <option value="tea">Tea</option>
                <option value="grey">Grey</option>
            </select>
        </div>
        <div class="font-selector">
            <select id="font-select">
                <option value="default">Default</option>
                <option value="Liberation Mono">Liberation Mono</option>
                <option value="Monospace Typewriter">Monospace Typewriter</option>
                <option value="Terminal D400">Terminal D400</option>
                <option value="Vera Mono">Vera Mono</option>
            </select>
        </div>
    </div>

    <div class="header">
        <h1><a href="/" style="color: inherit; text-decoration: none;">{{.Title}}</a></h1>
        <div class="tagline">Image Board Archive</div>
        <div class="quote">Preserving imageboard culture</div>
    </div>

    <nav class="flex flex-wrap items-center gap-3 border border-white/10 bg-neutral-900/70 px-4 py-3 backdrop-blur-sm shadow-[0_0_25px_rgba(255,255,255,0.05)]">
        <a class="text-xs sm:text-sm tracking-[0.35em]" href="/">[home]</a> |
        <a class="text-xs sm:text-sm tracking-[0.35em]" href="/overboard">[overboard]</a> |
        <a class="text-xs sm:text-sm tracking-[0.35em]" href="/search">[search]</a>
        {{range $site := .Sites}}
        | <a class="text-xs sm:text-sm tracking-[0.35em]" href="/site/{{$site.Site.Name}}">/{{$site.Site.Name}}/</a>
        {{end}}
    </nav>
    <div class="bottom-0 left-0 right-0 h-[2px] bg-gradient-to-r from-transparent via-white/40 to-transparent opacity-70"></div>

    {{template "content" .}}

    <div style="text-align: center; padding: 20px; font-size: 11px; color: #666;">
        Powered by Akyuu Image Board Archive
    </div>
</body>
</html>
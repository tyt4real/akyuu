{{define "content"}}
<div class="container mx-auto px-4 py-8">
    <h2 class="text-3xl font-bold text-center text-[var(--font-color)] mb-2">
        /{{.Site.Name}}/ - {{.Site.BaseURL}}
    </h2>

    {{if .Site.Platform}}
    <p class="text-center text-[var(--subordinate-header)] mb-6">
        Platform: {{.Site.Platform}}
    </p>
    {{end}}

    <div class="section rounded-[5px] mb-8">
        <div class="section-header">Boards</div>
        <div class="flex flex-wrap gap-4 justify-center">
            {{range .Boards}}
            <a href="/site/{{$.Site.Name}}/board/{{.Code}}"
               class="px-6 py-4 rounded-[5px] border border-gray-700 text-sm font-medium text-gray-100 whitespace-nowrap
                     transition-all duration-200 hover:ring-2 hover:ring-blue-500 hover:shadow-lg hover:shadow-blue-500/40">
                <strong>/{{.Code}}/ - {{.Title}}</strong>
                {{if .NSFW}}<span class="ml-2 text-red-400">[NSFW]</span>{{end}}
            </a>
            {{end}}
        </div>
    </div>

    <div class="section rounded-[5px]">
        <div class="section-header text-center text-[var(--font-color)] font-bold text-lg mb-4">
            Community
        </div>
        <div class="flex flex-wrap gap-4 justify-center">
            <a href="/overboard" class="px-6 py-4 rounded-[5px] border border-gray-700 text-sm font-medium text-gray-100 whitespace-nowrap transition-all duration-200 hover:ring-2 hover:ring-blue-500 hover:shadow-lg hover:shadow-blue-500/40">
                <strong>/overboard/</strong> - All recent posts
            </a>
            <a href="/search" class="px-6 py-4 rounded-[5px] border border-gray-700 text-sm font-medium text-gray-100 whitespace-nowrap transition-all duration-200 hover:ring-2 hover:ring-green-500 hover:shadow-lg hover:shadow-green-500/40">
                <strong>/search/</strong> - Search posts
            </a>
        </div>
    </div>